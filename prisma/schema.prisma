// =====================================
//   GENERATOR & DATASOURCE
// =====================================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================
//   ENUMS
// =====================================
enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  INACTIVE
}

enum ContactType {
  WHATSAPP
  CALL
  PROFILE_VIEW
}

// =====================================
//   GEOGRAPHY
// =====================================
model Country {
  id     Int    @id @default(autoincrement())
  name   String @unique
  nameAr String
  nameFr String
  cities City[]
}

model City {
  id        Int        @id @default(autoincrement())
  name      String
  nameAr    String
  nameFr    String
  countryId Int
  country   Country    @relation(fields: [countryId], references: [id])
  users     User[]
  providers Provider[]

  @@unique([name, countryId])
}

// =====================================
//   SERVICE CATEGORIES
// =====================================
model ServiceCategory {
  id            Int                  @id @default(autoincrement())
  slug          String               @unique
  name          String
  nameAr        String
  nameFr        String
  icon          String?
  description   String?
  descriptionAr String?
  descriptionFr String?
  order         Int                  @default(0)
  isActive      Boolean              @default(true)
  subcategories ServiceSubcategory[]
  providers     Provider[]
  createdAt     DateTime             @default(now())
}

model ServiceSubcategory {
  id         Int                   @id @default(autoincrement())
  slug       String                @unique
  name       String
  nameAr     String
  nameFr     String
  categoryId Int
  category   ServiceCategory       @relation(fields: [categoryId], references: [id])
  providers  ProviderSubcategory[]
  createdAt  DateTime              @default(now())
}

// =====================================
//   USERS
// =====================================
model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  phone       String?
  password    String
  role        UserRole     @default(CUSTOMER)
  avatarUrl   String?
  cityId      Int?
  city        City?        @relation(fields: [cityId], references: [id])
  provider    Provider?
  reviews     Review[]
  contactLogs ContactLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// =====================================
//   PROVIDERS
// =====================================
model Provider {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @unique
  user            User                  @relation(fields: [userId], references: [id])
  businessName    String
  bio             String?
  bioAr           String?
  bioFr           String?
  phone           String
  whatsapp        String?
  website         String?
  avatarUrl       String?
  cityId          Int
  city            City                  @relation(fields: [cityId], references: [id])
  categoryId      Int
  category        ServiceCategory       @relation(fields: [categoryId], references: [id])
  subcategories   ProviderSubcategory[]
  yearsExperience Int?
  status          ProviderStatus        @default(PENDING)
  availability    AvailabilityStatus    @default(AVAILABLE)
  isVerified      Boolean               @default(false)
  profileViews    Int                   @default(0)
  rating          Float                 @default(0)
  reviewCount     Int                   @default(0)
  adminNotes      String?
  portfolioImages PortfolioImage[]
  reviews         Review[]
  contactLogs     ContactLog[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ProviderSubcategory {
  providerId    Int
  subcategoryId Int
  provider      Provider           @relation(fields: [providerId], references: [id])
  subcategory   ServiceSubcategory @relation(fields: [subcategoryId], references: [id])

  @@id([providerId, subcategoryId])
}

// =====================================
//   PORTFOLIO
// =====================================
model PortfolioImage {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id])
  url        String
  caption    String?
  captionAr  String?
  captionFr  String?
  isBefore   Boolean  @default(false)
  pairId     String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// =====================================
//   REVIEWS
// =====================================
model Review {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  rating     Int
  comment    String?
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([providerId, userId])
}

// =====================================
//   CONTACT LOGS (analytics)
// =====================================
model ContactLog {
  id         Int         @id @default(autoincrement())
  providerId Int
  provider   Provider    @relation(fields: [providerId], references: [id])
  userId     Int?
  user       User?       @relation(fields: [userId], references: [id])
  type       ContactType
  ipAddress  String?
  createdAt  DateTime    @default(now())
}
