// =====================================
//   GENERATOR & DATASOURCE
// =====================================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================
//   ENUMS
// =====================================
enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  INACTIVE
}

enum ContactType {
  WHATSAPP
  CALL
  PROFILE_VIEW
}

enum TranslationLocale {
  en
  fr
  ar
}

// =====================================
//   I18N — TRANSLATIONS & PARAMS
// =====================================

// Stores all translatable text by code + locale.
// code format: "<NAMESPACE>_<KEY>"  e.g. "CAT_PLUMBING", "SUBCAT_PLUMBING_REPAIR"
model Translation {
  id        Int               @id @default(autoincrement())
  code      String            // e.g. "CAT_PLUMBING"
  locale    TranslationLocale // en | fr | ar
  text      String            // e.g. "Plomberie"
  namespace String            @default("general") // "category" | "subcategory" | "city" | "ui" | etc.
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([code, locale])
  @@index([namespace])
  @@index([code])
}

// System-wide configuration & transcodification params.
// Used for admin-managed settings, feature flags, and any
// key-value pair that needs to be translated or configured
// without a code deploy.
model Param {
  id          Int      @id @default(autoincrement())
  key         String   @unique // e.g. "SITE_NAME", "MAX_PROVIDERS_PER_CITY"
  value       String   // default / fallback value
  description String?  // for admin UI
  isPublic    Boolean  @default(false) // exposed to frontend
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================
//   GEOGRAPHY
// =====================================
model Country {
  id     Int    @id @default(autoincrement())
  code   String @unique // "MA", "FR" — used as translation key prefix
  name   String @unique // canonical name for internal use
  nameAr String
  nameFr String
  cities City[]
}

model City {
  id        Int        @id @default(autoincrement())
  code      String     @unique // "CASA", "RABAT" — translation key
  name      String     // canonical (usually French spelling)
  nameAr    String
  nameFr    String
  countryId Int
  country   Country    @relation(fields: [countryId], references: [id])
  users     User[]
  providers Provider[]

  @@unique([name, countryId])
}

// =====================================
//   SERVICE CATEGORIES
//   NO hardcoded translated text here.
//   Use the Translation table with code "CAT_<CODE>"
// =====================================
model ServiceCategory {
  id            Int                  @id @default(autoincrement())
  code          String               @unique // "PLUMBING", "ELECTRICITY" — translation key prefix
  slug          String               @unique // url-friendly
  icon          String?
  order         Int                  @default(0)
  isActive      Boolean              @default(true)
  subcategories ServiceSubcategory[]
  providers     Provider[]
  createdAt     DateTime             @default(now())

  // To get the name: SELECT text FROM Translation WHERE code = 'CAT_' || upper(code) AND locale = 'fr'
}

// =====================================
//   SERVICE SUBCATEGORIES
//   Translation key: "SUBCAT_<CODE>"
// =====================================
model ServiceSubcategory {
  id         Int                   @id @default(autoincrement())
  code       String                @unique // "PLUMBING_REPAIR", "ELEC_SOLAR"
  slug       String                @unique
  categoryId Int
  category   ServiceCategory       @relation(fields: [categoryId], references: [id])
  providers  ProviderSubcategory[]
  createdAt  DateTime              @default(now())

  // To get the name: SELECT text FROM Translation WHERE code = 'SUBCAT_' || upper(code) AND locale = 'fr'
}

// =====================================
//   USERS
// =====================================
model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  phone       String?
  password    String
  role        UserRole     @default(CUSTOMER)
  avatarUrl   String?
  cityId      Int?
  city        City?        @relation(fields: [cityId], references: [id])
  provider    Provider?
  reviews     Review[]
  contactLogs ContactLog[]
  reports     Report[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// =====================================
//   PROVIDERS
// =====================================
model Provider {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @unique
  user            User                  @relation(fields: [userId], references: [id])
  businessName    String
  // bio is free-text entered by the provider; stored in all 3 locales
  bio             String?
  bioAr           String?
  bioFr           String?
  phone           String
  whatsapp        String?
  website         String?
  avatarUrl       String?
  cityId          Int
  city            City                  @relation(fields: [cityId], references: [id])
  categoryId      Int
  category        ServiceCategory       @relation(fields: [categoryId], references: [id])
  subcategories   ProviderSubcategory[]
  yearsExperience Int?
  status          ProviderStatus        @default(PENDING)
  availability    AvailabilityStatus    @default(AVAILABLE)
  isVerified      Boolean               @default(false)
  profileViews    Int                   @default(0)
  rating          Float                 @default(0)
  reviewCount     Int                   @default(0)
  adminNotes      String?
  portfolioImages PortfolioImage[]
  reviews         Review[]
  contactLogs     ContactLog[]
  reports         Report[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ProviderSubcategory {
  providerId    Int
  subcategoryId Int
  provider      Provider           @relation(fields: [providerId], references: [id])
  subcategory   ServiceSubcategory @relation(fields: [subcategoryId], references: [id])

  @@id([providerId, subcategoryId])
}

// =====================================
//   PORTFOLIO
// =====================================
model PortfolioImage {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id])
  url        String
  caption    String?
  isBefore   Boolean  @default(false)
  pairId     String?  // links before/after images together
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// =====================================
//   REVIEWS
// =====================================
model Review {
  id         Int      @id @default(autoincrement())
  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      // 1–5
  comment    String?
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([providerId, userId])
}

// =====================================
//   REPORTS / DISPUTES
// =====================================
enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Report {
  id         Int          @id @default(autoincrement())
  providerId Int
  provider   Provider     @relation(fields: [providerId], references: [id])
  reporterId Int?
  reporter   User?        @relation(fields: [reporterId], references: [id])
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// =====================================
//   CONTACT LOGS (analytics)
// =====================================
model ContactLog {
  id         Int         @id @default(autoincrement())
  providerId Int
  provider   Provider    @relation(fields: [providerId], references: [id])
  userId     Int?
  user       User?       @relation(fields: [userId], references: [id])
  type       ContactType
  ipAddress  String?
  createdAt  DateTime    @default(now())
}
